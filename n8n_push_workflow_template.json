      "typeVersion": 2,
      "position": [240, 800],
      "webhookId": "iot-weather",
      "notes": "URL: http://YOUR_N8N:5678/webhook/iot-weather\nSet N8N_WEBHOOK_WEATHER in Django .env"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true}",
        "options": {}
      },
      "id": "respond-sensor",
      "name": "Respond 200 (sensor)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 100]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// Sensor data: build notification if anomaly\n// ─────────────────────────────────────────────\nconst d = $input.first().json.body;\nconst alerts = [];\n\nif ((d.temperature || 0) >= 35)\n  alerts.push(`🌡 Indoor Temp: ${d.temperature}°C (HIGH)`);\nif ((d.humidity || 0) >= 90)\n  alerts.push(`💧 Indoor Humidity: ${d.humidity}% (HIGH)`);\nif ((d.ds18b20 || 0) >= 40)\n  alerts.push(`🌡 DS18B20: ${d.ds18b20}°C (HIGH)`);\n\nreturn [{\n  json: {\n    has_alert: alerts.length > 0,\n    alerts,\n    message: alerts.length\n      ? `📡 Sensor Alert (${d.device_name})\\n` + alerts.join('\\n') + `\\n\\nTimestamp: ${d.timestamp}`\n      : '',\n    raw: d,\n  }\n}];"
      },
      "id": "analyze-sensor",
      "name": "Analyze Sensor",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "sensor-alert", "leftValue": "={{ $json.has_alert }}", "rightValue": true, "operator": {"type": "boolean","operation": "true"}}],
          "combinator": "or"
        }
      },
      "id": "if-sensor-alert",
      "name": "Sensor Anomaly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true}",
        "options": {}
      },
      "id": "respond-relay",
      "name": "Respond 200 (relay)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 320]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// Relay change: build notification message\n// ─────────────────────────────────────────────\nconst d = $input.first().json.body;\nconst icon = d.new_state === 'ON' ? '🟢' : '🔴';\nconst sourceMap = {\n  mqtt: 'ESP32',\n  ai_agent: 'AI Agent',\n  threshold: 'Threshold Auto',\n  dashboard: 'Dashboard',\n};\nconst src = sourceMap[d.source] || d.source;\nreturn [{\n  json: {\n    message: `${icon} Relay ${d.relay_number}: ${d.new_state}\\nSource: ${src}\\nReason: ${d.reason || 'N/A'}\\nTime: ${d.timestamp}`,\n    raw: d,\n  }\n}];"
      },
      "id": "format-relay",
      "name": "Format Relay Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 380]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true}",
        "options": {}
      },
      "id": "respond-alarm",
      "name": "Respond 200 (alarm)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 480]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// Alarm event: build critical notification\n// ─────────────────────────────────────────────\nconst d = $input.first().json.body;\nconst icon = d.alarm_active ? '🚨' : '✅';\nreturn [{\n  json: {\n    message: `${icon} Alarm ${d.alarm_state}\\nReason: ${d.reason || 'N/A'}\\nTime: ${d.timestamp}`,\n    raw: d,\n    is_critical: d.alarm_active === true,\n  }\n}];"
      },
      "id": "format-alarm",
      "name": "Format Alarm Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 540]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true}",
        "options": {}
      },
      "id": "respond-ai",
      "name": "Respond 200 (ai)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 640]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// AI Decision: log and notify summary\n// ─────────────────────────────────────────────\nconst d = $input.first().json.body;\nconst icon = d.decision === 'on' ? '✅ ON' : '🛑 OFF';\nreturn [{\n  json: {\n    message: `🤖 AI Decision: ${icon}\\nConfidence: ${d.confidence_pct}%\\nRelay ${d.relay_number}: ${d.command} (${d.command_success ? 'sent' : 'failed'})\\nReasoning: ${d.reasoning_summary}\\nTime: ${d.timestamp}`,\n    raw: d,\n  }\n}];"
      },
      "id": "format-ai",
      "name": "Format AI Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 700]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true}",
        "options": {}
      },
      "id": "respond-weather",
      "name": "Respond 200 (weather)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, 800]
    },
    {
      "parameters": {
        "jsCode": "// ─────────────────────────────────────────────\n// Weather log: check rain / AQI alerts\n// ─────────────────────────────────────────────\nconst d = $input.first().json.body;\nconst alerts = [];\n\nif ((d.rain_probability || 0) >= 70)\n  alerts.push(`🌧 Rain: ${d.rain_probability}%`);\nif ((d.temperature || 0) >= 38)\n  alerts.push(`🌡 Outdoor Temp: ${d.temperature}°C`);\nif ((d.aqi || 0) >= 4)\n  alerts.push(`🏭 AQI ${d.aqi} (${d.aqi_label}) — PM2.5: ${d.pm2_5} μg/m³`);\n\nconst summary = [\n  `🌤 Weather Update — ${d.city_name}`,\n  `Temp: ${d.temperature}°C (feels ${d.feels_like}°C) | Hum: ${d.humidity}%`,\n  `Wind: ${d.wind_speed} m/s | Clouds: ${d.clouds}% | Rain: ${d.rain_probability}%`,\n  `Condition: ${d.weather_desc} | AQI: ${d.aqi} (${d.aqi_label})`,\n  `PM2.5: ${d.pm2_5} | PM10: ${d.pm10} μg/m³`,\n  `Time: ${d.timestamp}`,\n].join('\\n');\n\nreturn [{\n  json: {\n    has_alert: alerts.length > 0,\n    alerts,\n    summary,\n    alert_message: alerts.length ? `⚠️ Weather Alerts:\\n` + alerts.join('\\n') + '\\n\\n' + summary : '',\n    raw: d,\n  }\n}];"
      },
      "id": "analyze-weather",
      "name": "Analyze Weather",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 860]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "weather-alert", "leftValue": "={{ $json.has_alert }}", "rightValue": true, "operator": {"type": "boolean","operation": "true"}}],
          "combinator": "or"
        }
      },
      "id": "if-weather-alert",
      "name": "Weather Alert?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 860]
    },
