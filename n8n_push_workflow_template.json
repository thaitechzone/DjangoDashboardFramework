  "__meta": {
    "_comment": "=== HOW TO USE (Push / Real-time Approach A) ===",
    "_step1": "Import this file in N8N: Settings → Import Workflow",
    "_step2": "Edit .env on Django server:",
    "_step2a": "  N8N_PUSH_ENABLED=true",
    "_step2b": "  N8N_WEBHOOK_SENSOR=http://YOUR_N8N:5678/webhook/iot-sensor",
    "_step2c": "  N8N_WEBHOOK_RELAY=http://YOUR_N8N:5678/webhook/iot-relay",
    "_step2d": "  N8N_WEBHOOK_ALARM=http://YOUR_N8N:5678/webhook/iot-alarm",
    "_step2e": "  N8N_WEBHOOK_AI=http://YOUR_N8N:5678/webhook/iot-ai",
    "_step2f": "  N8N_WEBHOOK_WEATHER=http://YOUR_N8N:5678/webhook/iot-weather",
    "_step3": "Create LINE Notify credential in N8N (HTTP Header Auth): Authorization = Bearer <token>",
    "_step4": "Activate all 5 webhook nodes in N8N",
    "_step5": "Restart Django server: run_backend.bat",
    "_event_map": {
      "sensor":  "Triggered every time ESP32 sends DHT22 + DS18B20 data via MQTT",
      "relay":   "Triggered every time a relay changes state (ESP32 / AI / Dashboard / Threshold)",
      "alarm":   "Triggered when alarm is activated or deactivated by threshold check",
      "ai":      "Triggered after each AI agent analysis cycle (default: every 60 min)",
      "weather": "Triggered every 15 minutes when weather logger saves a WeatherLog record"
    },
    "_payload_fields": {
      "all_events": ["event", "timestamp", "source"],
      "sensor":  ["device_name", "temperature", "humidity", "ds18b20", "sensor_id"],
      "relay":   ["relay_number", "new_state", "old_state", "changed", "source", "reason"],
      "alarm":   ["alarm_active", "alarm_state", "reason"],
      "ai":      ["decision", "confidence_pct", "reasoning_summary", "relay_number", "command", "command_success"],
      "weather": ["city_name", "temperature", "feels_like", "humidity", "pressure", "wind_speed", "clouds", "weather_main", "weather_desc", "rain_probability", "aqi", "aqi_label", "pm2_5", "pm10"]
    }
  }
