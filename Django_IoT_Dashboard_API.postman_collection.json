{
	"info": {
		"_postman_id": "django-iot-dashboard-api-v1",
		"name": "Django IoT Dashboard API",
		"description": "Complete REST API for Django IoT Dashboard - LED, Relay, and Sensor Data Management\n\n## Base URL\n- Development: `http://localhost:8000`\n- Production: `http://your-server.com`\n\n## Features\n- ✅ LED Control (GET status, POST commands)\n- ✅ Relay Control (GET status, POST commands for 3 relays)\n- ✅ Sensor Data (CRUD operations)\n- ✅ System Status (Complete overview)\n- ✅ Statistics (Sensor data analytics)\n\n## Authentication\nCurrently no authentication required (CSRF disabled for API)\n\n## Created by\nThaiTechZone - IoT Dashboard Project",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
