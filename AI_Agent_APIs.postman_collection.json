							"status": "OK",
							"code": 200,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"cookie": [],
							"body": "{\n    \"success\": true,\n    \"data\": {\n        \"scheduler\": {\n            \"is_running\": true,\n            \"interval_minutes\": 15,\n            \"next_run\": \"2024-10-22 11:00:00\"\n        },\n        \"recent_decisions\": [\n            {\n                \"id\": 5,\n                \"decision\": \"ON\",\n                \"confidence\": 0.85,\n                \"reasoning\": \"อุณหภูมิสูง (33.5°C) และความชื้นสูง (78%), แนวโน้มอุณหภูมิเพิ่มขึ้น\",\n                \"current_temperature\": 33.5,\n                \"current_humidity\": 78.0,\n                \"relay2_previous_status\": false,\n                \"relay2_new_status\": true,\n                \"action_taken\": true,\n                \"timestamp\": \"2024-10-22 10:45:00\"\n            }\n        ]\n    }\n}"
						}
					]
				},
