# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git

# Google Gemini AI API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key
# Get your API key from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Weather Location for Forecast
WEATHER_LOCATION=Tha Sala,TH

# AI Agent Settings (interval in minutes, minimum 60 recommended for free tier)
AI_AGENT_INTERVAL_MINUTES=60
