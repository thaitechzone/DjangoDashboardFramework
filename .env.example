# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git

# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=False
# Comma-separated, no spaces. Add your Render domain e.g. your-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=iot_dashboard
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ─── N8N Push Webhooks ────────────────────────────────────────────────────────
N8N_PUSH_ENABLED=false
N8N_PUSH_TIMEOUT=5
N8N_WEBHOOK_SNAPSHOT=
N8N_WEBHOOK_SENSOR=
N8N_WEBHOOK_RELAY=
N8N_WEBHOOK_ALARM=
N8N_WEBHOOK_AI=
N8N_WEBHOOK_WEATHER=

# ─── AI & Weather ─────────────────────────────────────────────────────────────
# Google Gemini AI API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key
# Get your API key from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Weather Location for Forecast
WEATHER_LOCATION=Tha Sala,TH

# AI Agent Settings (interval in minutes, minimum 60 recommended for free tier)
AI_AGENT_INTERVAL_MINUTES=60
